# ===== 基础 =====
NODE_ENV=development
APP_NAME=MixmAPP
APP_VERSION=0.0.0.0
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# 生产：PUBLIC_BASE_URL=https://api.mixm.top/mixmapp
# CORS：本模板默认 * 方便本地联调；生产必须改成显式白名单（表内来源见 deploy/domains.json）
# 生产值（主入口 www.mixm.top；裸域仅在 301 未生效的过渡期临时放行）：CORS_ORIGINS=https://www.mixm.top
# 切换完成后可加裸域（逗号分隔）：CORS_ORIGINS=https://www.mixm.top,https://mixm.top
# 壳与本地调试源（https://localhost、capacitor://localhost、http://localhost）由 services/api/src/config.ts 内置，无需写入
# 表外历史入口（afdk1991.github.io、*.tcloudbase.com）未在表内出现，标记待确认，未确认前不得写进生产白名单
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# 生产必须改成 32 字节以上随机串：openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30

# ===== 数据库（必填；免费云端可用 Neon / Supabase 的 PostgreSQL）=====
# 数据库落点：cloudbase = 权威云 PG（默认），server = 云服务器自建 PG（旧值 local 等价 server）
DB_TARGET=server
# 两个连接串可同时配置：改 DB_TARGET 或调 /api/v1/admin/db/switch 即切换，不用改 secrets
DATABASE_URL_CLOUDBASE=
DATABASE_URL_LOCAL=postgres://mixmapp:mixmapp@127.0.0.1:5432/mixmapp
# 兜底：上面两个都没配时用它
DATABASE_URL=postgres://mixmapp:mixmapp@127.0.0.1:5432/mixmapp
# 管理面令牌：设置后 /api/v1/admin/db 可用（带 x-admin-token）；不设则管理面整体 404
ADMIN_TOKEN=
RUN_MIGRATIONS=1
# 只有显式设 1 才允许无 DATABASE_URL 启动内存存储；仅限临时联调，数据重启即失
ALLOW_MEMORY_STORE=0

# ===== 自动发号 =====
# snowflake | ulid | uuidv7
ID_STRATEGY=snowflake
SNOWFLAKE_WORKER_ID=0

# ===== 短信 =====
# console | aliyun
SMS_PROVIDER=console
DEV_ECHO_SMS_CODE=1
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=MixmAPP
ALIYUN_SMS_TEMPLATE_CODE=

# ===== 第三方登录 =====
OAUTH_WECHAT_APP_ID=
OAUTH_WECHAT_APP_SECRET=
OAUTH_QQ_APP_ID=
OAUTH_QQ_APP_KEY=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Apple 登录：填 Sign in with Apple 的 Service ID / Bundle ID，端侧上传 identityToken
OAUTH_APPLE_CLIENT_ID=

# ===== 一键登录（本机号码认证）=====
# dev | http；dev 模式 token 形如 dev:13800001234，仅非生产环境可用
ONEKEY_PROVIDER=dev
# http 模式必填：运营商/本机号码认证网关地址，需返回 {"phone":"13800001234"}
ONEKEY_ENDPOINT=
ONEKEY_APP_ID=
ONEKEY_APP_SECRET=

# ===== 用户名合规 =====
# 按监管要求补充的政治/违法/低俗词库，逗号或空白分隔；命中即拒绝注册
USERNAME_DENYLIST=

# ===== 支付 =====
PAY_WECHAT_APP_ID=
PAY_WECHAT_MCH_ID=
PAY_WECHAT_SERIAL_NO=
# PEM 内容，换行写成 \n
PAY_WECHAT_PRIVATE_KEY=
PAY_WECHAT_API_V3_KEY=
PAY_WECHAT_PLATFORM_PUBLIC_KEY=
PAY_WECHAT_NOTIFY_URL=https://api.mixm.top/mixmapp/api/v1/pay/notify/wechat
PAY_ALIPAY_APP_ID=
PAY_ALIPAY_PRIVATE_KEY=
PAY_ALIPAY_PUBLIC_KEY=
PAY_ALIPAY_NOTIFY_URL=https://api.mixm.top/mixmapp/api/v1/pay/notify/alipay

# ===== 地图 / 定位 =====
# dev | amap
MAP_PROVIDER=dev
AMAP_KEY=

# ===== 对象存储（S3 兼容：R2 / OSS / MinIO / AWS）=====
# dev | s3
# 默认 local：文件落在 STORAGE_DIR，由 nginx 的 /media/ 直出，不用任何对象存储
STORAGE_PROVIDER=local
STORAGE_DIR=/var/lib/mixmapp/storage
STORAGE_API_BASE=/mixmapp/api/v1
# 仅在改用 S3 兼容对象存储时填写
S3_ENDPOINT_PLACEHOLDER=
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=auto
S3_BUCKET=mixmapp
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ===== 推送 =====
# dev | jpush | fcm
PUSH_PROVIDER=dev
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# ===== AI（OpenAI 兼容协议）=====
# dev | doubao | openai
AI_PROVIDER=dev
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=
AI_MODEL=doubao-pro-32k
