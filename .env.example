# ===== 基础 =====
NODE_ENV=development
APP_NAME=MixmAPP
APP_VERSION=0.0.0
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# 生产：PUBLIC_BASE_URL=https://api.mixm.top/mixmapp
# CORS：本模板默认 * 方便本地联调；生产必须改成显式白名单（表内来源见 deploy/domains.json）
# 生产值（主入口 www.mixm.top；裸域仅在 301 未生效的过渡期临时放行）：CORS_ORIGINS=https://www.mixm.top
# 切换完成后可加裸域（逗号分隔）：CORS_ORIGINS=https://www.mixm.top,https://mixm.top
# 壳与本地调试源（https://localhost、capacitor://localhost、http://localhost）由 services/api/src/config.ts 内置，无需写入
# Pages 入口 https://afdk1991.github.io 已加入生产白名单（2026-11-14，供 Pages 站点跨域取数）；
# *.tcloudbase.com 仍未确认归属，未确认前不得写进生产白名单
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# 生产必须改成 32 字节以上随机串：openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30

# ===== 数据库（必填；免费云端可用 Neon / Supabase 的 PostgreSQL）=====
# 数据库落点：cloudbase = 权威云 PG（默认），server = 云服务器自建 PG（旧值 local 等价 server）
DB_TARGET=server
# 两个连接串可同时配置：改 DB_TARGET 或调 /api/v1/admin/db/switch 即切换，不用改 secrets
DATABASE_URL_CLOUDBASE=
DATABASE_URL_LOCAL=postgres://mixmapp:mixmapp@127.0.0.1:5432/mixmapp
# 兜底：上面两个都没配时用它
DATABASE_URL=postgres://mixmapp:mixmapp@127.0.0.1:5432/mixmapp
# 管理面令牌：设置后 /api/v1/admin/db 可用（带 x-admin-token）；不设则管理面整体 404
ADMIN_TOKEN=
RUN_MIGRATIONS=1
# 只有显式设 1 才允许无 DATABASE_URL 启动内存存储；仅限临时联调，数据重启即失
ALLOW_MEMORY_STORE=0

# ===== 自动发号 =====
# snowflake | ulid | uuidv7
ID_STRATEGY=snowflake
SNOWFLAKE_WORKER_ID=0

# ===== 短信 =====
# console | aliyun
SMS_PROVIDER=console
DEV_ECHO_SMS_CODE=1
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=MixmAPP
ALIYUN_SMS_TEMPLATE_CODE=

# ===== 第三方登录（配置驱动，留空即视为未启用，登录页不渲染该入口）=====
# 回调地址：留空自动用 PUBLIC_BASE_URL + /api/v1/auth/oauth/<provider>/callback
# 每个渠道还支持 OAUTH_<KEY>_REDIRECT_URI / OAUTH_<KEY>_SCOPE / OAUTH_<KEY>_ENABLED
PUBLIC_BASE_URL=http://localhost:8080
# 登录后允许回跳的站内域名白名单，逗号分隔；生产为空时只允许 PUBLIC_BASE_URL 同源
OAUTH_REDIRECT_WHITELIST=
OAUTH_DEFAULT_REDIRECT=
# state 一次性票据有效期（秒）
OAUTH_STATE_TTL_SEC=600
# 仅非生产环境可用：开启后登录页出现「Mock 调试登录」，用于无凭证跑通全流程
OAUTH_MOCK_ENABLED=0

# 微信开放平台（网页扫码，scope=snsapi_login）
OAUTH_WECHAT_APP_ID=
OAUTH_WECHAT_APP_SECRET=
# 微信公众号网页授权（scope=snsapi_userinfo），与扫码共用 AppID/AppSecret
OAUTH_WECHAT_MP_ENABLED=0
# QQ 互联
OAUTH_QQ_APP_ID=
OAUTH_QQ_APP_KEY=
# 微博开放平台
OAUTH_WEIBO_APP_ID=
OAUTH_WEIBO_APP_SECRET=
# 支付宝开放平台：应用私钥 + 支付宝公钥（缺公钥不会启用，避免不验签）
OAUTH_ALIPAY_APP_ID=
OAUTH_ALIPAY_PRIVATE_KEY=
OAUTH_ALIPAY_PUBLIC_KEY=
# 抖音开放平台
OAUTH_DOUYIN_CLIENT_KEY=
OAUTH_DOUYIN_CLIENT_SECRET=
# 钉钉
OAUTH_DINGTALK_CLIENT_ID=
OAUTH_DINGTALK_CLIENT_SECRET=
# 企业微信：企业 ID + 自建应用 Secret + AgentId
OAUTH_WECOM_CORP_ID=
OAUTH_WECOM_APP_SECRET=
OAUTH_WECOM_AGENT_ID=
# Apple：Service ID（Web）/ Bundle ID（App）；client_secret 可直接填，或用 TeamID+KeyID+私钥生成
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
# .p8 私钥内容，换行写成 \n
OAUTH_APPLE_PRIVATE_KEY=
# Google / Facebook / GitHub / Gitee
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITEE_CLIENT_ID=
OAUTH_GITEE_CLIENT_SECRET=

# ===== 一键登录（本机号码认证）=====
# dev | http；dev 模式 token 形如 dev:13800001234，仅非生产环境可用
ONEKEY_PROVIDER=dev
# http 模式必填：运营商/本机号码认证网关地址，需返回 {"phone":"13800001234"}
ONEKEY_ENDPOINT=
ONEKEY_APP_ID=
ONEKEY_APP_SECRET=

# ===== 用户名合规 =====
# 按监管要求补充的政治/违法/低俗词库，逗号或空白分隔；命中即拒绝注册
USERNAME_DENYLIST=

# ===== 支付 =====
PAY_WECHAT_APP_ID=
PAY_WECHAT_MCH_ID=
PAY_WECHAT_SERIAL_NO=
# PEM 内容，换行写成 \n
PAY_WECHAT_PRIVATE_KEY=
PAY_WECHAT_API_V3_KEY=
PAY_WECHAT_PLATFORM_PUBLIC_KEY=
PAY_WECHAT_NOTIFY_URL=https://api.mixm.top/mixmapp/api/v1/pay/notify/wechat
PAY_ALIPAY_APP_ID=
PAY_ALIPAY_PRIVATE_KEY=
PAY_ALIPAY_PUBLIC_KEY=
PAY_ALIPAY_NOTIFY_URL=https://api.mixm.top/mixmapp/api/v1/pay/notify/alipay

# ===== 地图 / 定位 =====
# dev | amap
MAP_PROVIDER=dev
AMAP_KEY=

# ===== 对象存储（S3 兼容：R2 / OSS / MinIO / AWS）=====
# dev | s3
# 默认 local：文件落在 STORAGE_DIR，由 nginx 的 /media/ 直出，不用任何对象存储
STORAGE_PROVIDER=local
STORAGE_DIR=/var/lib/mixmapp/storage
STORAGE_API_BASE=/mixmapp/api/v1
# 仅在改用 S3 兼容对象存储时填写
S3_ENDPOINT_PLACEHOLDER=
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=auto
S3_BUCKET=mixmapp
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ===== 推送 =====
# dev | jpush | fcm
PUSH_PROVIDER=dev
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# ===== AI（OpenAI 兼容协议）=====
# dev | doubao | openai
AI_PROVIDER=dev
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=
AI_MODEL=doubao-pro-32k
