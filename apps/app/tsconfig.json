{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@dcloudio/types", "node"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@mixmapp/contracts": ["../../packages/contracts/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "unpackage"]
}
