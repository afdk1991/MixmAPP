<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        styles.xml 的 AppTheme 引用了这三个颜色，但仓库里此前没有定义，
        aapt2 链接阶段会报 "resource color/colorPrimary not found"。这里补齐，
        取值与 apps/app/src/uni.scss 的品牌色（$brand / $brand-deep）保持一致。
    -->
    <color name="colorPrimary">#0F9D8F</color>
    <color name="colorPrimaryDark">#0A7A70</color>
    <color name="colorAccent">#0F9D8F</color>

    <!--
        壳层窗口 / WebView 底色，与 H5 深色主题的纸底色一一对应：
        浅色 #F4F4F1 = theme.scss :root 的 mx-paper，
        夜间 #121716 = (prefers-color-scheme: dark) 的 mx-paper（见 values-night/colors.xml）。
        原生侧取同一个值时，首帧渲染前不会出现「白底 → 深色页面」的闪屏。
    -->
    <color name="app_background">#F4F4F1</color>
</resources>
