{
  "name": "mixmapp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @mixmapp/api dev",
    "dev:h5": "pnpm --filter @mixmapp/app dev:h5",
    "dev:mp-weixin": "pnpm --filter @mixmapp/app dev:mp-weixin",
    "build:api": "pnpm --filter @mixmapp/api build",
    "build:h5": "node scripts/build-h5.mjs",
    "build:mp-weixin": "pnpm --filter @mixmapp/app build:mp-weixin",
    "build:app": "pnpm --filter @mixmapp/app build:app",
    "build:harmony": "pnpm --filter @mixmapp/app build:harmony",
    "build": "pnpm run build:api && pnpm run build:h5",
    "test": "pnpm -r --no-bail test",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "node scripts/repo-lint.mjs",
    "verify": "node scripts/verify.mjs",
    "db:migrate": "pnpm --filter @mixmapp/api db:migrate",
    "ops:health": "node scripts/healthcheck.mjs",
    "ops:backup": "node scripts/backup.mjs",
    "build:h5:single": "node scripts/build-h5-single.mjs",
    "version:show": "node scripts/version.mjs show",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:bump": "node scripts/version.mjs bump",
    "version:release": "node scripts/version.mjs release",
    "domains:show": "node scripts/domains.mjs show",
    "domains:check": "node scripts/domains.mjs check"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
